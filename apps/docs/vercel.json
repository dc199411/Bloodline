{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@bloodline/docs...",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile=false",
  "outputDirectory": ".next",
  "ignoreCommand": "cd ../.. && git diff --quiet HEAD^ HEAD ./apps/docs ./pnpm-lock.yaml ./turbo.json"
}
