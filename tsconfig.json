{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "references": [
    { "path": "packages/shared" },
    { "path": "apps/api" },
    { "path": "packages/runtime" },
    { "path": "packages/sdk" }
  ],
  "exclude": [
    "node_modules",
    "apps/miniapp",
    "packages/contracts",
    "agent-templates"
  ]
}
